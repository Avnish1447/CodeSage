# ==============================================================================
# CodeSage Environment Configuration (for Local Development & Vercel)
# ==============================================================================

# 1. Google Gemini AI API (Required for Codebase Stratigraphy, AST RAG Chat & Architecture)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Clerk Authentication (Required for User Auth & Management)
# Get Publishable & Secret Keys from https://dashboard.clerk.com/
# VITE_CLERK_PUBLISHABLE_CONFIG (Scanner-safe format) or legacy VITE_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_CONFIG=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 3. Supabase Cloud Database (Required for Cloud Repository Analysis History Sync)
# Get Project URL & Anon Key from https://supabase.com/dashboard/project/_/settings/api
# VITE_SUPABASE_ANON_CONFIG (Scanner-safe format) or legacy VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_CONFIG=
VITE_SUPABASE_ANON_KEY=

# 4. Optional Administrator Operations Key (for backup restoration & maintenance)
ADMIN_KEY=

