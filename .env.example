# Google Gemini AI Key (Required for AI Stratigraphy, RAG Chat, and Architecture Summaries)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Clerk Authentication (Get Publishable & Secret Keys from https://dashboard.clerk.com/)
# Use VITE_CLERK_PUBLISHABLE_CONFIG (or legacy VITE_CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_CONFIG=
CLERK_SECRET_KEY=

# Supabase Cloud Database (Get Project URL & Anon Key from https://supabase.com/dashboard)
# Use VITE_SUPABASE_ANON_CONFIG (or legacy VITE_SUPABASE_ANON_KEY)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_CONFIG=
