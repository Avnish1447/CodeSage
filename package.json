{
  "name": "codesage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:compression": "tsx server/tests/test_compression_upload.ts",
    "test:errors": "tsx server/tests/test_error_logging.ts",
    "test:concurrency": "tsx server/tests/test_concurrency.ts",
    "test:backups": "tsx server/tests/test_backup_restoration.ts",
    "test:seo": "tsx server/tests/test_seo_links.ts",
    "test:404": "tsx server/tests/test_404_page.ts",
    "test:all": "tsx server/tests/test_compression_upload.ts && tsx server/tests/test_error_logging.ts && tsx server/tests/test_concurrency.ts && tsx server/tests/test_backup_restoration.ts && tsx server/tests/test_seo_links.ts && tsx server/tests/test_404_page.ts"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.2.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "multer": "^2.4.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
